theorem IsUgly_mul_2 {n : Nat} (h : IsUgly n) : IsUgly (n * 2) := by
  -- Since $n$ is ugly, multiplying it by $2$ will also result in an ugly number because $2$ is a prime factor of the resulting number.
  obtain ⟨hn_pos, hn_factors⟩ := h;
  use by
    -- Since $n$ is positive and $2$ is positive, their product $n * 2$ is also positive.
    apply mul_pos hn_pos (by norm_num);
  intro p hp_prime hp_div;
  have h_div_n : p ∣ n ∨ p = 2 := by
    -- Since $p$ is prime and divides $n * 2$, it must divide either $n$ or $2$.
    have h_div_n_or_2 : p ∣ n ∨ p ∣ 2 := by
      exact hp_prime.dvd_mul.mp hp_div
    generalize_proofs at *;
    exact Or.imp id ( fun h => by have := Nat.le_of_dvd ( by decide ) h; interval_cases p <;> trivial ) h_div_n_or_2
  generalize_proofs at *;
  grind

