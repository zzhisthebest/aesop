theorem IsUgly_one : IsUgly 1 := by
  -- By definition, 1 is an ugly number because it has no prime factors.
  simp [IsUgly];
  -- Since primes are greater than 1, the assumption p = 1 leads to a contradiction.
  intros p hp h_eq_one
  exfalso
  exact Nat.Prime.ne_one hp h_eq_one

def IsUglySeq (l : List Nat) : Prop :=
  l.Sorted (· < ·) ∧
  l ≠ [] ∧
  (∀ x ∈ l, IsUgly x) ∧
  (∀ y, IsUgly y → y < l.getLastD 0 → y ∈ l)

theorem IsUglySeq_singleton_one : IsUglySeq [1] := by
  -- The base case is when the list is empty. We need to show that 1 is ugly.
  simp [IsUglySeq];
  -- The number 1 is considered ugly.
  simp [IsUgly];
  -- The first part of the conjunction is trivially true since 1 is not prime.
  aesop

def LoopInvariant (seq : List Nat) (c2 c3 c5 : Nat) : Prop :=
  IsUglySeq seq ∧
  c2 < seq.length ∧ c3 < seq.length ∧ c5 < seq.length ∧
  (∀ k, k < c2 → seq[k]! * 2 ≤ seq.getLastD 0) ∧
  (∀ k, k < c3 → seq[k]! * 3 ≤ seq.getLastD 0) ∧
  (∀ k, k < c5 → seq[k]! * 5 ≤ seq.getLastD 0) ∧
  seq[c2]! * 2 > seq.getLastD 0 ∧
  seq[c3]! * 3 > seq.getLastD 0 ∧
  seq[c5]! * 5 > seq.getLastD 0

