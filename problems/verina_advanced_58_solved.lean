  -- Since $l$ is sorted and $x > l.getLastD 0$, all elements in $l$ are less than $x$. Therefore, $l ++ [x]$ is sorted.
  have h_all_lt_x : ∀ y ∈ l, y < x := by
    -- By induction on the list l, we can show that all elements are less than x.
    induction' l with y l ih;
    · grind;
    · simp +zetaDelta at *;
      grind;
  -- Since $l$ is sorted and $x > l.getLastD 0$, all elements in $l$ are less than $x$. Therefore, $l ++ [x]$ is sorted by the properties of sorted lists.
  apply List.pairwise_append.mpr;
  -- Since $l$ is sorted and $x > l.getLastD 0$, all elements in $l$ are less than $x$. Therefore, $l ++ [x]$ is sorted by the properties of sorted lists and the fact that $x$ is greater than all elements in $l$.
  simp [h_sorted, h_all_lt_x];
  exact ⟨ h_sorted, h_all_lt_x ⟩

theorem IsUgly_decomposition {u : Nat} (hu : IsUgly u) (h_gt_1 : u > 1) :
    ∃ u' p, IsUgly u' ∧ (p = 2 ∨ p = 3 ∨ p = 5) ∧ u = u' * p ∧ u' < u := by
  -- Since $u$ is greater than 1, it must have a prime factor $p$ that is 2, 3, or 5.
  obtain ⟨p, hp⟩ : ∃ p, Nat.Prime p ∧ p ∣ u ∧ (p = 2 ∨ p = 3 ∨ p = 5) := by
    -- By definition of IsUgly, since u > 1, u must have at least one prime factor from the set {2, 3, 5}.
    obtain ⟨p, hp⟩ : ∃ p, Nat.Prime p ∧ p ∣ u := by
      -- Since $u > 1$, it must have at least one prime factor.
      apply Nat.exists_prime_and_dvd; exact h_gt_1.ne';
    have := hu.2 p hp.1 hp.2; aesop;
  obtain ⟨ u', rfl ⟩ := hp.2.1;
  refine' ⟨ u', p, _, hp.2.2, mul_comm _ _, _ ⟩;
  · exact ⟨ Nat.pos_of_ne_zero ( by aesop_cat ), fun q hq hq' => hu.2 q hq ( dvd_mul_of_dvd_right hq' _ ) ⟩;
  · nlinarith [ hp.1.two_le ]

theorem IsUglySeq_contains_one (l : List Nat) (h : IsUglySeq l) : 1 ∈ l := by
  -- By definition of IsUglySeq, l must contain all ugly numbers less than its last element, and since 1 is the smallest ugly number, it must be in l.
  have h_one_in_l : 1 ∈ l := by
    have h_first : l ≠ [] := by
      -- By definition of IsUglySeq, l ≠ [].
      apply h.2.1
    -- Since 1 is the smallest ugly number and l is non-empty, 1 must be the first element of l.
    have h_one_in_l : 1 ∈ l := by
      have h_first : l ≠ [] := h_first
      have h_ugly : IsUgly 1 := by
        exact?
      have h_one_in_l : ∀ {l : List ℕ}, IsUglySeq l → 1 ∈ l := by
        intros l hl; obtain ⟨ hl_sorted, hl_nonempty, hl_ugly, hl_all ⟩ := hl; exact (by
        rcases l with ( _ | ⟨ x, _ | ⟨ y, l ⟩ ⟩ ) <;> simp_all +decide;
        · exact Eq.symm ( le_antisymm ( le_of_not_gt fun h => by linarith [ hl_all 1 h_ugly h ] ) ( Nat.pos_of_ne_zero hl_ugly.1.ne' ) );
        · grind);
      exact h_one_in_l h;
    exact h_one_in_l;
  -- Since 1 is in l by hypothesis, we can conclude the proof.
  exact h_one_in_l

theorem candidate_ge_next (seq : List Nat) (c2 c3 c5 : Nat)
    (h_inv : LoopInvariant seq c2 c3 c5)
    (k : Nat) (hk : k < seq.length)
    (p : Nat) (hp : p = 2 ∨ p = 3 ∨ p = 5)
    (h_gt : seq[k]! * p > seq.getLastD 0) :
    seq[k]! * p >= (nextUgly seq c2 c3 c5).1 := by
  -- By definition of `nextUgly`, we know that `nextUgly seq c2 c3 c5` is the minimum of `seq[c2]! * 2`, `seq[c3]! * 3`, and `seq[c5]! * 5`.
  have h_next_def : (nextUgly seq c2 c3 c5).1 = min (seq[c2]! * 2) (min (seq[c3]! * 3) (seq[c5]! * 5)) := by
    rfl;
  rcases h_inv with ⟨ h₁, h₂, h₃, h₄, h₅, h₆, h₇, h₈ ⟩;
  rcases hp with ( rfl | rfl | rfl ) <;> simp_all +decide;
  · contrapose! h₅;
    use k;
    -- Since $k < c2$ and $seq[k] < seq[c2]$, we have $k < c2$.
    have h_k_lt_c2 : k < c2 := by
      have h_sorted : seq.Sorted (· < ·) := by
        exact h₁.1;
      have := List.pairwise_iff_get.mp h_sorted;
      exact lt_of_not_ge fun h => h₅.1.not_le <| le_of_lt <| this ⟨ c2, h₂ ⟩ ⟨ k, hk ⟩ <| lt_of_le_of_ne h <| Ne.symm <| by aesop;
    grind;
  · contrapose! h₆;
    use k;
    -- Since $k$ is a valid index, we can use the fact that $seq[k]?.getD 0$ is just $seq[k]$.
    have h_k_lt_c3 : k < c3 := by
      have := h₁.1;
      have := List.pairwise_iff_get.mp this;
      exact lt_of_not_ge fun h => h₆.2.1.not_le <| le_of_lt <| this ⟨ c3, by linarith ⟩ ⟨ k, by linarith ⟩ <| lt_of_le_of_ne h <| Ne.symm <| by aesop;
    grind;
  · contrapose! h_gt;
    convert h₇ k ( Nat.lt_of_not_ge fun h => by linarith [ show seq[k] ≥ seq[c5] from by
                                                            have := List.pairwise_iff_get.mp h₁.1;
                                                            exact monotone_iff_forall_lt.mpr ( fun i j hij => le_of_lt ( this i j hij ) ) ( show c5 ≤ k from h ) ] ) using 1;
    grind

theorem next_is_next_ugly (seq : List Nat) (c2 c3 c5 : Nat)
    (h_inv : LoopInvariant seq c2 c3 c5) :
    let next := (nextUgly seq c2 c3 c5).1
    ∀ u, IsUgly u → u < next → u ∈ seq := by
  intro next u hu hu_lt_next
  by_cases hu_gt_last : u > seq.getLastD 0;
  · -- Let `u` be the *smallest* such ugly number (i.e., `u > seq.getLastD 0`, `u < next`, and `u` is ugly).
    obtain ⟨u', hu'_min, hu'_lt_next, hu'_gt_last, hu'_in_seq⟩ : ∃ u', IsUgly u' ∧ u' < next ∧ u' > seq.getLastD 0 ∧ ∀ v, IsUgly v → v < next → v > seq.getLastD 0 → u' ≤ v := by
      exact ⟨ Nat.find ( ⟨ u, hu, hu_lt_next, hu_gt_last ⟩ : ∃ u', IsUgly u' ∧ u' < next ∧ u' > seq.getLastD 0 ), Nat.find_spec ( ⟨ u, hu, hu_lt_next, hu_gt_last ⟩ : ∃ u', IsUgly u' ∧ u' < next ∧ u' > seq.getLastD 0 ) |>.1, Nat.find_spec ( ⟨ u, hu, hu_lt_next, hu_gt_last ⟩ : ∃ u', IsUgly u' ∧ u' < next ∧ u' > seq.getLastD 0 ) |>.2.1, Nat.find_spec ( ⟨ u, hu, hu_lt_next, hu_gt_last ⟩ : ∃ u', IsUgly u' ∧ u' < next ∧ u' > seq.getLastD 0 ) |>.2.2, fun v hv hv_lt_next hv_gt_last => Nat.find_min' _ ⟨ hv, hv_lt_next, hv_gt_last ⟩ ⟩;
    -- By `IsUgly_decomposition`, `u' = u'' * p` where `u''` is ugly, `u'' < u'`, and `p ∈ {2, 3, 5}`.
    obtain ⟨u'', p, hu''_min, hp, hu'_eq⟩ : ∃ u'' p, IsUgly u'' ∧ (p = 2 ∨ p = 3 ∨ p = 5) ∧ u' = u'' * p ∧ u'' < u' := by
      by_cases hu'_gt_1 : u' > 1;
      · exact?;
      · interval_cases u' <;> simp_all +decide [ IsUgly ];
        have := h_inv.1.1; simp_all +decide [ List.Sorted ] ;
        rcases seq with ( _ | ⟨ x, _ | ⟨ y, seq ⟩ ⟩ ) <;> simp_all +decide [ List.getLast? ];
        · cases h_inv ; aesop;
        · cases h_inv.1.2.2.1 0 ( by norm_num ) ; aesop;
        · have := h_inv.1.2.2.1 0; simp_all +decide ;
          grind;
    -- Since `u''` is ugly and `u'' ≤ seq.getLastD 0`, by `h_inv`, `u'' ∈ seq`.
    have hu''_in_seq : u'' ∈ seq := by
      have := h_inv.1.2.2.2;
      grind;
    -- Let `k` be the index of `u''` in `seq`. Then `u' = seq[k]! * p`.
    obtain ⟨k, hk⟩ : ∃ k, k < seq.length ∧ seq[k]! = u'' := by
      obtain ⟨ k, hk ⟩ := List.mem_iff_get.mp hu''_in_seq; use k; aesop;
    -- Since `u' = seq[k]! * p` and `u' > seq.getLastD 0`, we can apply `candidate_ge_next` to `seq[k]! * p`.
    have hu'_ge_next : seq[k]! * p ≥ next := by
      apply candidate_ge_next seq c2 c3 c5 h_inv k hk.left p hp;
      grind;
    grind;
  · have h_seq_gt_u : seq.Sorted (· < ·) ∧ seq ≠ [] ∧ (∀ x ∈ seq, IsUgly x) ∧ (∀ y, IsUgly y → y < seq.getLastD 0 → y ∈ seq) := by
      exact h_inv.1;
    have h_seq_gt_u : ∀ {l : List ℕ}, List.Sorted (· < ·) l → l ≠ [] → (∀ x ∈ l, IsUgly x) → (∀ y, IsUgly y → y < l.getLastD 0 → y ∈ l) → ∀ y, IsUgly y → y ≤ l.getLastD 0 → y ∈ l := by
      intros l hl_sorted hl_nonempty hl_ugly hl_lt_last y hy hy_le_last
      induction' l with x l ih generalizing y;
      · contradiction;
      · grind;
    grind

theorem LoopInvariant_step (seq : List Nat) (c2 c3 c5 : Nat)
    (h_inv : LoopInvariant seq c2 c3 c5) :
    let (next, c2', c3', c5') := nextUgly seq c2 c3 c5
    LoopInvariant (seq ++ [next]) c2' c3' c5' := by
  -- Show that the new sequence and indices satisfy the loop invariant.
  simp [LoopInvariant] at *;
  refine' ⟨ _, _, _, _, _ ⟩;
  · refine' ⟨ _, _, _, _ ⟩;
    · have h_sorted : (nextUgly seq c2 c3 c5).1 > seq.getLastD 0 := by
        -- Since the minimum of the three products is greater than the last element, the next element must be greater than the last element.
        have h_next_gt_last : (nextUgly seq c2 c3 c5).1 = min (seq[c2]! * 2) (min (seq[c3]! * 3) (seq[c5]! * 5)) := by
          exact?;
        grind;
      have h_sorted : List.Sorted (· < ·) seq := by
        exact h_inv.1.1;
      exact?;
    · aesop;
    · -- By definition of `nextUgly`, the next element is the minimum of `seq[c2]! * 2`, `seq[c3]! * 3`, and `seq[c5]! * 5`, all of which are ugly numbers.
      have h_next_ugly : IsUgly (nextUgly seq c2 c3 c5).1 := by
        apply IsUgly_nextUgly;
        -- By definition of `LoopInvariant`, we need to show that the sequence is sorted, non-empty, contains only ugly numbers, and includes all ugly numbers less than the last element.
        apply And.intro h_inv.left;
        grind;
      simp +zetaDelta at *;
      rintro x ( hx | rfl ) <;> [ exact h_inv.1.2.2.1 x hx; exact h_next_ugly ];
    · -- By definition of `nextUgly`, we know that `(nextUgly seq c2 c3 c5).1` is the smallest ugly number greater than `seq.getLastD 0`.
      have h_next_ugly : ∀ y, IsUgly y → y < (nextUgly seq c2 c3 c5).1 → y ∈ seq := by
        apply next_is_next_ugly;
        -- By definition of `LoopInvariant`, we need to show that the sequence is sorted, non-empty, contains only ugly numbers, and includes all ugly numbers less than the last element.
        apply And.intro h_inv.left;
        grind;
      grind;
  · -- Since $c2 < \text{length}(seq)$, adding 1 to $c2$ gives $c2' < \text{length}(seq) + 1$.
    have h_c2'_lt : (nextUgly seq c2 c3 c5).2.1 ≤ c2 + 1 := by
      unfold nextUgly; aesop;
    linarith;
  · -- Since $c3 < seq.length$, adding 1 to $c3$ will still be less than $seq.length + 1$. Therefore, $(nextUgly seq c2 c3 c5).2.2.1 < seq.length + 1$.
    have h_c3_lt : (nextUgly seq c2 c3 c5).2.2.1 ≤ c3 + 1 := by
      unfold nextUgly; aesop;
    linarith;
  · simp [nextUgly];
    grind;
  · unfold nextUgly;
    simp +zetaDelta at *;
    refine' ⟨ _, _, _ ⟩;
    · intro k hk; split_ifs at hk <;> simp_all +decide [ List.getElem?_append ] ;
      · grind;
      · grind;
    · grind;
    · refine' ⟨ _, _, _ ⟩;
      · grind;
      · split_ifs <;> simp_all +decide [ List.getElem_append ];
        · -- Since the list is sorted, we have seq[c2] < seq[c2+1] when c2+1 < seq.length.
          by_cases h_case : c2 + 1 < seq.length;
          · have := h_inv.1.1;
            replace := List.pairwise_iff_get.mp this;
            exact Or.inl ( by simpa [ h_case ] using this ⟨ c2, by linarith ⟩ ⟨ c2 + 1, by linarith ⟩ ( Nat.lt_succ_self _ ) );
          · grind;
        · grind;
      · constructor <;> split_ifs <;> simp_all +decide [ List.getElem_append ];
        · split_ifs <;> simp_all +decide [ min_eq_iff ];
          · have := h_inv.1.1;
            have := List.pairwise_iff_get.mp this;
            exact Or.inr <| Or.inl <| this ⟨ c3, by linarith ⟩ ⟨ c3 + 1, by linarith ⟩ <| Nat.lt_succ_self _;
          · grind;
        · grind;
        · split_ifs <;> simp_all +decide [ Nat.mul_succ ];
          · have := h_inv.1.1;
            have := List.pairwise_iff_get.mp this;
            exact Or.inr <| Or.inr <| this ⟨ c5, by linarith ⟩ ⟨ c5 + 1, by linarith ⟩ <| Nat.lt_succ_self _;
          · grind;
        · grind

theorem LoopInvariant_base : LoopInvariant [1] 0 0 0 := by
  -- Show that [1] is a sorted list of ugly numbers.
  simp [LoopInvariant, IsUglySeq];
  -- Since 1 is positive and has no prime factors, it is an ugly number.
  have h1 : IsUgly 1 := by
    -- By definition, 1 is an ugly number.
    apply IsUgly_one
  exact ⟨h1, by intro y hy hy0; exact absurd hy0 (by exact Nat.ne_of_gt (hy.left))⟩

theorem IsUglySeq_implies_nth_ugly (l : List Nat) (h : IsUglySeq l) :
    ((List.range (l.getLastD 0)).filter (fun i => isUgly i)).length = l.length - 1 := by
  -- By definition of `IsUglySeq`, we know that `l` contains exactly the first `l.length` ugly numbers.
  have h_seq : List.toFinset (List.filter (fun i => isUgly i) (List.range (l.getLastD 0))) = List.toFinset (List.dropLast l) := by
    ext xop;
    norm_num +zetaDelta at *;
    constructor;
    · intro hxop
      have h_mem : xop ∈ List.filter (fun i => isUgly i) (List.range (l.getLastD 0)) := by
        rw [ List.mem_filter ] ; aesop;
      have h_mem : xop ∈ l := by
        have h_mem : ∀ y, IsUgly y → y < l.getLastD 0 → y ∈ l := by
          exact h.2.2.2;
        rw [ isUgly_iff_IsUgly ] at hxop ; aesop;
      rw [ List.mem_iff_get ] at *;
      obtain ⟨ n, hn ⟩ := ‹∃ n : Fin l.length, l.get n = xop›; use ⟨ n, by
        grind ⟩ ; aesop;
    · intro hxop;
      -- Since `l` is sorted and contains only ugly numbers, any element in `l.dropLast` must be less than the last element of `l`.
      have h_lt_last : xop < l.getLastD 0 := by
        have h_lt_last : ∀ {l : List ℕ}, List.Sorted (· < ·) l → ∀ x ∈ l.dropLast, x < l.getLastD 0 := by
          -- We can prove this by induction on the list.
          intro l hl x hx
          induction' l with a l ih generalizing x;
          · contradiction;
          · -- If x is in the dropLast of a :: l, then x is either in l.dropLast or x is a.
            by_cases hx_l : x ∈ l.dropLast;
            · cases l <;> aesop;
            · rcases l with ( _ | ⟨ b, l ⟩ ) <;> simp_all +decide [ List.getLastD ];
              induction l using List.reverseRecOn <;> aesop;
        exact h_lt_last h.1 xop hxop;
      exact ⟨ by simpa using h_lt_last, by simpa using isUgly_iff_IsUgly xop |>.2 ( h.2.2.1 xop <| List.mem_of_mem_dropLast hxop ) ⟩;
  rw [ ← List.toFinset_card_of_nodup, h_seq, List.toFinset_card_of_nodup ];
  · exact?;
  · exact h.1.nodup.sublist ( List.dropLast_sublist _ );
  · refine' List.Nodup.filter _ _;
    exact?

#check nthUglyNumber.loop

theorem LoopInvariant_loop (i : Nat) (seq : List Nat) (c2 c3 c5 : Nat)
    (h_inv : LoopInvariant seq c2 c3 c5) :
    ∃ c2' c3' c5', LoopInvariant (nthUglyNumber.loop i seq c2 c3 c5) c2' c3' c5' ∧
    (nthUglyNumber.loop i seq c2 c3 c5).length = seq.length + i := by
  -- By definition of `nthUglyNumber.loop`, we can apply the invariant step by step.
  induction' i with i ih generalizing seq c2 c3 c5;
  · exact ⟨ c2, c3, c5, h_inv, rfl ⟩;
  · -- By definition of `nthUglyNumber.loop`, we can apply the induction hypothesis to the result of `nextUgly` and the updated counters.
    obtain ⟨c2', c3', c5', h_inv', h_len⟩ := ih (seq ++ [(nextUgly seq c2 c3 c5).1]) (if (nextUgly seq c2 c3 c5).1 = seq[c2]! * 2 then c2 + 1 else c2) (if (nextUgly seq c2 c3 c5).1 = seq[c3]! * 3 then c3 + 1 else c3) (if (nextUgly seq c2 c3 c5).1 = seq[c5]! * 5 then c5 + 1 else c5) (LoopInvariant_step seq c2 c3 c5 h_inv);
    -- By definition of `nthUglyNumber.loop`, we can rewrite the goal in terms of the loop function and apply the induction hypothesis.
    simp [nthUglyNumber.loop];
    -- By definition of `nthUglyNumber.loop`, we can rewrite the goal in terms of the loop function and apply the induction hypothesis to conclude the proof.
    apply And.intro;
    · exact ⟨ _, _, _, by simpa [ nextUgly ] using h_inv' ⟩;
    · convert h_len using 1 ; simp +arith +decide [ add_comm, add_left_comm, add_assoc ]

theorem nthUglyNumber_spec_satisfied (n: Nat) (h_precond : nthUglyNumber_precond (n)) :
    nthUglyNumber_postcond (n) (nthUglyNumber (n) h_precond) h_precond := by
  -- By `LoopInvariant_loop`, there exist `c2', c3', c5'` such that `LoopInvariant seq c2' c3' c5'` holds, and `seq.length = 1 + (n - 1) = n`.
  obtain ⟨c2', c3', c5', h_inv, h_len⟩ : ∃ c2' c3' c5', LoopInvariant (nthUglyNumber.loop (n - 1) [1] 0 0 0) c2' c3' c5' ∧ (nthUglyNumber.loop (n - 1) [1] 0 0 0).length = 1 + (n - 1) := by
    have := LoopInvariant_loop ( n - 1 ) [ 1 ] 0 0 0 LoopInvariant_base; aesop;
  -- Since `seq.length = n`, `seq[(n - 1)]!` is the last element of `seq`.
  have h_last : (nthUglyNumber.loop (n - 1) [1] 0 0 0)[(n - 1)]! = (nthUglyNumber.loop (n - 1) [1] 0 0 0).getLastD 0 := by
    grind;
  -- From `h_inv`, we know `IsUglySeq seq`.
  have h_ugly_seq : IsUglySeq (nthUglyNumber.loop (n - 1) [1] 0 0 0) := by
    exact h_inv.1;
  -- This implies all elements of `seq` are ugly, so `isUgly (seq[(n - 1)]!) = true`.
  have h_ugly : isUgly ((nthUglyNumber.loop (n - 1) [1] 0 0 0).getLastD 0) = true := by
    convert h_ugly_seq.2.2.1 _ _;
    convert isUgly_iff_IsUgly _;
    grind;
  -- Also, `IsUglySeq_implies_nth_ugly` tells us that the number of ugly numbers less than `seq.getLastD 0` is `seq.length - 1`.
  have h_count : ((List.range ((nthUglyNumber.loop (n - 1) [1] 0 0 0).getLastD 0)).filter (fun i => isUgly i)).length = (nthUglyNumber.loop (n - 1) [1] 0 0 0).length - 1 := by
    apply IsUglySeq_implies_nth_ugly; assumption;
  unfold nthUglyNumber; aesop;
