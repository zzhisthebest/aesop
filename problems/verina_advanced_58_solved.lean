theorem IsUgly_mul_5 {n : Nat} (h : IsUgly n) : IsUgly (n * 5) := by
  -- By definition of IsUgly, if n is ugly, then multiplying it by 5 (which is a prime factor of an ugly number) should still result in an ugly number.
  unfold IsUgly at *;
  -- Since n is positive, multiplying it by 5 will keep it positive. So n*5 > 0 is straightforward.
  simp [h.left];
  -- If p divides n*5, then by the properties of primes, p must divide n or p must divide 5.
