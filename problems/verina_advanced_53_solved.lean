      by_cases h_neg : minimumRightShifts nums h_precond = -1;
      · -- By definition of `minimumRightShifts`, if `minimumRightShifts nums h_precond = -1`, then for all `k`, `k < nums.length` implies `¬ List.Sorted (· ≤ ·) (nums.rotateRight k)`.
        have h_all_not_sorted : ∀ k, k < nums.length → ¬ List.Sorted (· ≤ ·) (nums.rotateRight k) := by
          -- Apply the theorem that states if the result is -1, then for all k < n, the list rotated by k is not sorted. Use the hypothesis h_neg.
          apply minimumRightShifts_neg_one_spec; assumption;
        rcases nums with ( _ | ⟨ x, _ | ⟨ y, l ⟩ ⟩ ) <;> simp_all +decide;
        · -- Since the list is empty, the function returns 0, which contradicts h_neg.
          simp [minimumRightShifts] at h_neg;
        · convert h_all_not_sorted using 1;
      · have := @minimumRightShifts_pos_spec nums h_precond;
        rcases n : nums.length with ( _ | _ | n ) <;> simp_all +decide;
        · rfl;
        · unfold minimumRightShifts; aesop;
        · tauto
